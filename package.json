{
  "name": "caliper-ui",
  "version": "1.0.1",
  "description": "Typed React primitives with no runtime package beyond React.",
  "license": "MIT",
  "files": [
    "src/components",
    "src/lib",
    "src/styles"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/components/index.ts",
    "./button": "./src/components/ui/button.tsx",
    "./input": "./src/components/ui/input.tsx",
    "./textarea": "./src/components/ui/textarea.tsx",
    "./checkbox": "./src/components/ui/checkbox.tsx",
    "./radio-group": "./src/components/ui/radio-group.tsx",
    "./progress": "./src/components/ui/progress.tsx",
    "./field": "./src/components/ui/field.tsx",
    "./select": "./src/components/ui/select.tsx",
    "./dropdown-menu": "./src/components/ui/dropdown-menu.tsx",
    "./slider": "./src/components/ui/slider.tsx",
    "./gauge": "./src/components/ui/gauge.tsx",
    "./kbd": "./src/components/ui/kbd.tsx",
    "./table": "./src/components/ui/table.tsx",
    "./dialog": "./src/components/ui/dialog.tsx",
    "./command-palette": "./src/components/ui/command-palette.tsx",
    "./disclosure": "./src/components/ui/disclosure.tsx",
    "./icons": "./src/components/ui/icons.tsx",
    "./cn": "./src/lib/cn.ts",
    "./clipboard": "./src/lib/clipboard.ts",
    "./styles.css": "./src/styles/globals.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/analytics": "^2.0.1",
    "next": "^16.4.4",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.91.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.16.1"
}
