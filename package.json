{
  "name": "caliper-ui",
  "version": "0.1.0",
  "description": "Typed React primitives with no runtime package beyond React.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src/components",
    "src/lib",
    "src/styles"
  ],
  "exports": {
    ".": "./src/components/index.ts",
    "./styles.css": "./src/styles/globals.css",
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@12.2.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "next": "^16.3.4",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
