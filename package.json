{
  "name": "caliper-ui",
  "version": "0.1.0",
  "description": "Typed React primitives with no runtime package beyond React.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src/components",
    "src/lib",
    "src/styles"
  ],
  "exports": {
    ".": "./src/components/index.ts",
    "./button": "./src/components/ui/button.tsx",
    "./input": "./src/components/ui/input.tsx",
    "./field": "./src/components/ui/field.tsx",
    "./select": "./src/components/ui/select.tsx",
    "./slider": "./src/components/ui/slider.tsx",
    "./gauge": "./src/components/ui/gauge.tsx",
    "./kbd": "./src/components/ui/kbd.tsx",
    "./table": "./src/components/ui/table.tsx",
    "./bento-grid": "./src/components/ui/bento-grid.tsx",
    "./dialog": "./src/components/ui/dialog.tsx",
    "./command-palette": "./src/components/ui/command-palette.tsx",
    "./disclosure": "./src/components/ui/disclosure.tsx",
    "./icons": "./src/components/ui/icons.tsx",
    "./cn": "./src/lib/cn.ts",
    "./clipboard": "./src/lib/clipboard.ts",
    "./styles.css": "./src/styles/globals.css",
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@12.2.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "next": "^16.3.4",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
